[Unit]
Description=ONTOVis protected evidence workbench (development-test)
After=network.target

[Service]
Type=simple
User=ontovis
Group=ontovis
WorkingDirectory=/data/ontovis/workbench-current/code
EnvironmentFile=/data/ontovis/private/workbench-scope.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/data/ontovis/runtime/gis-current/bin/python /data/ontovis/workbench-current/code/apps/api/workbench_server.py --project-code ${ONTOVIS_PROJECT_CODE} --installation-context-id ${ONTOVIS_INSTALLATION_CONTEXT_ID} --model-root /data/ontovis/private/workbench-model --library-root /data/ontovis/private/workbench-library --terrain-python /data/ontovis/runtime/gis-current/bin/python --terrain-max-upload-bytes 100000000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/ontovis/private/workbench-library
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=1536M
TasksMax=64
LimitNOFILE=256
UMask=0077

[Install]
WantedBy=multi-user.target
